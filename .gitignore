# ════════════════════════════════════
#  LessonRecorder — .gitignore
#  Windows + macOS + Linux
# ════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Виртуальные окружения ─────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── PyInstaller ───────────────────────────────────────────────────────────
build/
dist/
*.spec.bak

# ── Данные приложения ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log

# ── IDE / редакторы ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store          # macOS

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ── Windows ───────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ── Linux ─────────────────────────────────────────────────────────────────
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Тесты ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Установщики / билды ───────────────────────────────────────────────────
*.dmg
*.AppImage
*.tar.gz
*.zip
*.exe
installer/Output/

# ── Временные файлы ───────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
RELEASE_NOTES.md   # Генерируется перед релизом
